<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Simplifier.TestManagement.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
            x:DataType="vm:WelcomeToSSTMViewModel"
             x:Class="Simplifier.TestManagement.Views.WelcomeToSSTMView">
    <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <TextBlock Text="{Binding Greeting}"/>
        <suki:GlassCard>
            <Button Content="New Project" Command="{Binding CreateNewProject}"/>
        </suki:GlassCard>
        <suki:GlassCard>
            <Button Content="Open Project"/>
        </suki:GlassCard>
    </StackPanel>
</UserControl>
