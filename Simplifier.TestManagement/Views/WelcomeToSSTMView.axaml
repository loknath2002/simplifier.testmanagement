<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Simplifier.TestManagement.ViewModels"
             xmlns:models="using:Simplifier.TestManagement.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:DataType="vm:WelcomeToSSTMViewModel"
             x:Class="Simplifier.TestManagement.Views.WelcomeToSSTMView">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="40" Margin="40">
        <TextBlock Text="{Binding Greeting}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding SubGreeting}" FontSize="16" HorizontalAlignment="Center" Margin="0, -20, 0, 0"/>
        
        <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
            <suki:GlassCard IsInteractive="True" Command="{Binding CreateNewProjectCommand}" Width="200" Height="150">
                <TextBlock FontWeight="Bold" Text="New Project" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24"/>
            </suki:GlassCard>
            <suki:GlassCard IsInteractive="True" Command="{Binding OpenExistingProjectCommand}" Width="200" Height="150">
                <TextBlock FontWeight="Bold" Text="Open Project" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24"/>
            </suki:GlassCard>
        </StackPanel>
        
        <suki:GlassCard MinWidth="420">
            <StackPanel Margin="20">
                <TextBlock Text="Recent Projects" FontSize="20" FontWeight="Bold" Margin="0, 0, 0, 10"/>
                <ListBox ItemsSource="{Binding RecentProjects}"
                         SelectedItem="{Binding SelectedRecentProject}"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:TestProjectModel">
                            <StackPanel ToolTip.Tip="{Binding ProjectPath}">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DirectoryPath}" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </suki:GlassCard>
    </StackPanel>
</UserControl>
