<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Simplifier.TestManagement.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:ProjectCreationWizardViewModel"
             x:Class="Simplifier.TestManagement.Views.ProjectCreationWizardView">
    <suki:GlassCard VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40" Padding="20" Width="500">
        <StackPanel Spacing="20">
            <TextBlock Text="Let's create a SSTM Project" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
            
            <StackPanel Spacing="10">
                <TextBlock Text="Project Name"/>
                <TextBox Text="{Binding Project.Name}"/>
            </StackPanel>
            
            <StackPanel Spacing="10">
                <TextBlock Text="Project Location"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBox Text="{Binding Project.DirectoryPath}" Width="350"/>
                    <Button Command="{Binding PickFolderCommand}" Content="Browse"/>
                </StackPanel>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0, 10, 0, 0">
                <Button Content="Cancel" Command="{Binding CancelCommand}"/>
                <Button Content="Proceed" Command="{Binding ProceedCommand}"/>
            </StackPanel>
        </StackPanel>
    </suki:GlassCard>
</UserControl>
